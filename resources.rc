//
// Menu
//

IDR_MENU2 MENU
BEGIN
    POPUP "Game"
    BEGIN
        MENUITEM "New game\tF2",                ID_GAME_NEWGAME
        MENUITEM "Quit\tAlt+F4",                ID_GAME_EXIT
    END
    POPUP "Difficulty"
    BEGIN
        MENUITEM "Easy (8x8)\tCtrl+1",          ID_DIFFICULTY_EASY
        MENUITEM "Medium (16x16)\tCtrl+2",      ID_DIFFICULTY_MEDIUM
        MENUITEM "Expert (30x16)\tCtrl+3",      ID_DIFFICULTY_EXPERT
        MENUITEM "Synak (40x20)\t Ctrl+4",      ID_DIFFICULTY_SYNAK
        MENUITEM SEPARATOR
        MENUITEM "Custom...",                   ID_DIFFICULTY_CUSTOM
    END
    POPUP "About"
    BEGIN
        MENUITEM "Info",                        ID_ABOUT_INFO
        MENUITEM "Help\tF1",                    ID_ABOUT_HELP
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    "1",            ID_DIFFICULTY_EASY,     VIRTKEY, CONTROL, NOINVERT
    "3",            ID_DIFFICULTY_EXPERT,   VIRTKEY, CONTROL, NOINVERT
    "2",            ID_DIFFICULTY_MEDIUM,   VIRTKEY, CONTROL, NOINVERT
    "4",            ID_DIFFICULTY_SYNAK,    VIRTKEY, CONTROL, NOINVERT
    VK_F4,          ID_GAME_EXIT,           VIRTKEY, ALT, NOINVERT
    VK_F2,          ID_GAME_NEWGAME,        VIRTKEY, NOINVERT
    VK_F1,          ID_ABOUT_HELP,          VIRTKEY, NOINVERT
END


